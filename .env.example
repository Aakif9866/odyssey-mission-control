# Generation + agent (Groq, OpenAI-compatible)
GROQ_API_KEY=
GEN_BASE_URL=https://api.groq.com/openai/v1
GEN_MODEL=openai/gpt-oss-120b
GEN_FALLBACK_MODEL=openai/gpt-oss-20b

# Judge for evals (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-flash

# LangSmith tracing (v2): every run traced, tagged with commit SHA, PII redacted in-process (app/obs.py)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=odyssey

# Qdrant server (docker run -d --name odyssey-qdrant -p 6333:6333 qdrant/qdrant:v1.20.0); unset = embedded folder
QDRANT_URL=http://localhost:6333

# --- v2 production hardening ---
# Postgres (Neon, pooled URL): runs, telemetry, alerts, feedback + LangGraph checkpoints survive redeploys. Unset = local SQLite.
DATABASE_URL=

# Neon Auth (Managed Better Auth). Backend verifies JWTs; unset = no auth, users keyed by IP.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Frontend only (frontend/.env.local + Vercel): cookie secret (openssl rand -base64 32) and the UI switch
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_AUTH=0

# Email alerts on error-rate / p95 latency / fallback spikes (app/alerts.py). Gmail: smtp.gmail.com:587 + app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Per-user limits (defaults shown)
RATE_PER_MIN=10
DAILY_TOKENS=200000
MAX_LLM_CALLS=15
